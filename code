import { useState, useEffect, useMemo } from "react";

function Input({ ...props }) {
  return <input {...props} className="border p-2 w-full rounded" />;
}

function Select({ children, ...props }) {
  return (
    <select {...props} className="border p-2 w-full rounded">
      {children}
    </select>
  );
}

function Card({ children }) {
  return <div className="border p-4 mt-4 rounded shadow-md">{children}</div>;
}

function CardContent({ children }) {
  return <div>{children}</div>;
}

function Modal({ isOpen, onClose, onConfirm, children }) {
  if (!isOpen) return null;
  return (
    <div className="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center">
      <div className="bg-white p-6 rounded shadow-lg w-96">
        {children}
        <div className="flex justify-end mt-4 space-x-2">
          <button
            onClick={onClose}
            className="bg-gray-500 text-white px-4 py-2 rounded hover:bg-gray-600"
          >
            Cancel
          </button>
          <button
            onClick={onConfirm}
            className="bg-red-500 text-white px-4 py-2 rounded hover:bg-red-600"
          >
            Confirm
          </button>
        </div>
      </div>
    </div>
  );
}

// Mock database (local JSON data)
const mockRecipes = [
  {
    id: "1",
    name: "Lemon Super Juice",
    basePeelWeight: 1,
    ingredients: [
      { name: "Peels", amount: 1 },
      { name: "Citric Acid", amount: 1 },
      { name: "Water", amount: 16.66667 },
    ],
  },
];

export default function RecipeScalingApp() {
  const [recipes, setRecipes] = useState([]);
  const [selectedRecipe, setSelectedRecipe] = useState(null);
  const [peelWeight, setPeelWeight] = useState(0);
  const [isAddingRecipe, setIsAddingRecipe] = useState(false);
  const [isEditingRecipe, setIsEditingRecipe] = useState(false);
  const [newRecipe, setNewRecipe] = useState({
    name: "",
    basePeelWeight: 0,
    ingredients: [{ name: "", amount: 0 }],
  });
  const [errorMessage, setErrorMessage] = useState("");
  const [successMessage, setSuccessMessage] = useState("");
  const [isModalOpen, setIsModalOpen] = useState(false);
  const [recipeToDelete, setRecipeToDelete] = useState(null);

  // Load mock recipes on mount
  useEffect(() => {
    setRecipes(mockRecipes);
  }, []);

  // Handle recipe selection
  function handleRecipeChange(recipeId) {
    const recipe = recipes.find((r) => r.id === recipeId);
    if (!recipe) return;
    setSelectedRecipe(recipe);
    setPeelWeight(recipe.basePeelWeight);
  }

  // Memoize scaled ingredients
  const scaledIngredients = useMemo(() => {
    if (!selectedRecipe || peelWeight === 0) return [];
    return selectedRecipe.ingredients.map((ing) => ({
      name: ing.name,
      amount: ((peelWeight / selectedRecipe.basePeelWeight) * ing.amount).toFixed(2),
    }));
  }, [selectedRecipe, peelWeight]);

  // Handle peel weight change
  function handlePeelWeightChange(event) {
    setPeelWeight(parseFloat(event.target.value));
  }

  // Handle form changes for adding or editing a recipe
  function handleNewRecipeChange(event) {
    const { name, value } = event.target;
    setNewRecipe((prevRecipe) => ({
      ...prevRecipe,
      [name]: value,
    }));
  }

  // Handle ingredient changes for the new or edited recipe
  function handleIngredientChange(index, event) {
    const { name, value } = event.target;
    const updatedIngredients = [...newRecipe.ingredients];
    updatedIngredients[index] = { ...updatedIngredients[index], [name]: value };
    setNewRecipe((prevRecipe) => ({
      ...prevRecipe,
      ingredients: updatedIngredients,
    }));
  }

  // Add a new ingredient to the recipe
  function handleAddIngredient() {
    setNewRecipe((prevRecipe) => ({
      ...prevRecipe,
      ingredients: [...prevRecipe.ingredients, { name: "", amount: 0 }],
    }));
  }

  // Add or update the recipe
  function handleAddNewRecipe() {
    if (!validatePeelWeight()) return; // Ensure validation passes before proceeding

    const newRecipeWithId = {
      ...newRecipe,
      id: String(Date.now()), // Unique ID generation
    };
    setRecipes((prevRecipes) => [...prevRecipes, newRecipeWithId]);
    setSuccessMessage("Recipe added successfully!");
    setIsAddingRecipe(false);
    setNewRecipe({
      name: "",
      basePeelWeight: 0,
      ingredients: [{ name: "", amount: 0 }],
    });
    setTimeout(() => setSuccessMessage(""), 3000);
  }

  // Handle delete recipe with confirmation modal
  function handleDeleteRecipe(recipeId) {
    setRecipeToDelete(recipeId);
    setIsModalOpen(true);
  }

  function confirmDeleteRecipe() {
    setRecipes((prevRecipes) => prevRecipes.filter((r) => r.id !== recipeToDelete));
    if (selectedRecipe && selectedRecipe.id === recipeToDelete) {
      setSelectedRecipe(null);
      setPeelWeight(0);
    }
    setSuccessMessage("Recipe deleted successfully!");
    setRecipeToDelete(null);
    setIsModalOpen(false);
    setTimeout(() => setSuccessMessage(""), 3000);
  }

  function cancelDeleteRecipe() {
    setRecipeToDelete(null);
    setIsModalOpen(false);
  }

  // Enable edit mode with current recipe data
  function handleEditRecipe() {
    setNewRecipe({ ...selectedRecipe });
    setIsEditingRecipe(true);
    setIsAddingRecipe(true);
  }

  // Validation for required peel weight
  function validatePeelWeight() {
    if (!peelWeight || peelWeight <= 0) {
      setErrorMessage("Peel weight is required and must be greater than 0.");
      setTimeout(() => setErrorMessage(""), 3000);
      return false;
    }
    return true;
  }

  return (
    <div className="p-4 max-w-lg mx-auto">
      <h1 className="text-xl font-bold mb-4">Recipe Scaling App</h1>

      {/* Recipe Selector */}
      <Select onChange={(e) => handleRecipeChange(e.target.value)}>
        <option value="">Select a recipe</option>
        {recipes.map((recipe) => (
          <option key={recipe.id} value={recipe.id}>
            {recipe.name}
          </option>
        ))}
      </Select>

      {/* Feedback Messages */}
      {errorMessage && (
        <div className="text-red-500 mt-2">{errorMessage}</div>
      )}
      {successMessage && (
        <div className="text-green-500 mt-2">{successMessage}</div>
      )}

      {/* Button to Add New Recipe */}
      <button
        onClick={() => setIsAddingRecipe(true)}
        className="bg-blue-500 text-white px-4 py-2 rounded hover:bg-blue-600 mt-4"
      >
        Add Recipe
      </button>

      {/* Delete Recipe Button */}
      {selectedRecipe && (
        <div className="mt-4">
          <button
            onClick={() => handleDeleteRecipe(selectedRecipe.id)}
            className="bg-red-500 text-white px-4 py-2 rounded hover:bg-red-600"
          >
            Delete Recipe
          </button>
        </div>
      )}

      {/* Peel Weight Input */}
      {selectedRecipe && (
        <div className="mt-4">
          <label className="block font-bold mb-2">Peel Weight:</label>
          <Input
            type="number"
            value={peelWeight}
            onChange={handlePeelWeightChange}
            placeholder="Enter peel weight"
          />
        </div>
      )}

      {/* Scaled Ingredients */}
      {scaledIngredients.length > 0 && (
        <Card>
          <h2 className="text-xl font-semibold">Scaled Ingredients</h2>
          <CardContent>
            {scaledIngredients.map((ingredient) => (
              <div key={ingredient.name}>
                <span>{ingredient.name}: </span>
                <span>{ingredient.amount}</span>
              </div>
            ))}
          </CardContent>
        </Card>
      )}

      {/* Modal for Recipe Deletion Confirmation */}
      <Modal
        isOpen={isModalOpen}
        onClose={cancelDeleteRecipe}
        onConfirm={confirmDeleteRecipe}
      >
        <p>Are you sure you want to delete this recipe?</p>
      </Modal>

      {/* New Recipe Modal */}
      <Modal isOpen={isAddingRecipe} onClose={() => setIsAddingRecipe(false)}>
        <h2 className="text-xl font-bold mb-4">{isEditingRecipe ? "Edit Recipe" : "Add New Recipe"}</h2>
        <div>
          <label className="block">Name:</label>
          <Input
            name="name"
            value={newRecipe.name}
            onChange={handleNewRecipeChange}
            placeholder="Enter recipe name"
          />
        </div>
        <div>
          <label className="block">Base Peel Weight:</label>
          <Input
            type="number"
            name="basePeelWeight"
            value={newRecipe.basePeelWeight}
            onChange={handleNewRecipeChange}
            placeholder="Enter base peel weight"
          />
        </div>
        <div className="mt-4">
          <h3 className="font-semibold">Ingredients:</h3>
          {newRecipe.ingredients.map((ingredient, index) => (
            <div key={index} className="flex space-x-2 mb-2">
              <Input
                name="name"
                value={ingredient.name}
                onChange={(e) => handleIngredientChange(index, e)}
                placeholder="Ingredient Name"
              />
              <Input
                name="amount"
                type="number"
                value={ingredient.amount}
                onChange={(e) => handleIngredientChange(index, e)}
                placeholder="Amount"
              />
            </div>
          ))}
          <button
            onClick={handleAddIngredient}
            className="bg-green-500 text-white px-4 py-2 rounded hover:bg-green-600"
          >
            Add Ingredient
          </button>
        </div>
        <div className="mt-4 flex justify-end space-x-2">
          <button
            onClick={() => setIsAddingRecipe(false)}
            className="bg-gray-500 text-white px-4 py-2 rounded hover:bg-gray-600"
          >
            Cancel
          </button>
          <button
            onClick={handleAddNewRecipe}
            className="bg-blue-500 text-white px-4 py-2 rounded hover:bg-blue-600"
          >
            {isEditingRecipe ? "Save" : "Add Recipe"}
          </button>
        </div>
      </Modal>
    </div>
  );
}
